{
  "version": 2,
  "env": {
    "VITE_API_URL": "/api"
  },
  "installCommand": "npm install --ignore-scripts",
  "buildCommand": "cd client && npm install && VITE_API_URL=/api npm run build",
  "outputDirectory": "client/dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
